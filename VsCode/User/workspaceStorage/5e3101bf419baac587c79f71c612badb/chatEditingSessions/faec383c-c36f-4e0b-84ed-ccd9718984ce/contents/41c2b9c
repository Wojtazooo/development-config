parameters:
  solution: '**/*.sln'
  configuration: 'Release'
  buildPlatform: 'Any CPU'

steps:
  - task: NuGetToolInstaller@1
    displayName: 'Install NuGet Tool'

  - task: NuGetCommand@2
    displayName: 'Restore NuGet Packages'
    inputs:
      restoreSolution: '${{ parameters.solution }}'

  - task: VSBuild@1
    displayName: 'Build solution' # Build solution before packaging is required for /umbraco files to be copies to the output folder
    inputs:
      solution: '${{ parameters.solution }}'
      msbuildArgs: '/p:RestorePackages=false'
      platform: '${{ parameters.buildPlatform }}'
      configuration: '${{ parameters.configuration }}'

  - task: VSBuild@1
    displayName: 'Build and Package Solution'
    inputs:
      solution: '${{ parameters.solution }}'
      msbuildArgs: >
        /p:RestorePackages=false
        /p:DeployOnBuild=true
        /p:WebPublishMethod=Package
        /p:PackageAsSingleFile=true
        /p:SkipInvalidConfigurations=true
        /p:PackageLocation="$(Build.ArtifactStagingDirectory)\\"
      platform: '${{ parameters.buildPlatform }}'
      configuration: '${{ parameters.configuration }}'

  - task: VSTest@2
    displayName: 'Run Unit Tests'
    enabled: false
    inputs:
      testAssemblyVer2: |
        **\${{ parameters.configuration }}\*test*.dll
        !**\obj\**
      platform: '${{ parameters.buildPlatform }}'
      configuration: '${{ parameters.configuration }}'
